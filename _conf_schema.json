{
    "enable_platforms": {
        "description": "启用的平台",
        "hint": "勾选要启用解析的平台。",
        "type": "list",
        "options": [
            "B站",
            "抖音",
            "小红书",
            "微博",
            "X"
        ],
        "default": [
            "B站",
            "抖音",
            "小红书",
            "微博",
            "X"
        ]
    },
    "bili_settings": {
        "description": "B站设置",
        "type": "object",
        "items": {
            "video_quality": {
                "description": "B站视频下载画质",
                "type": "string",
                "hint": "选择下载视频的画质。未登录（含仅匿名指纹）时画质自动限制在 720P 及以下；1080P 及以上需要有效 SESSDATA。",
                "default": "1080P高帧率",
                "options": [
                    "原画 (最高画质)",
                    "8K",
                    "4K",
                    "1080P高帧率",
                    "1080P",
                    "720P",
                    "最低"
                ]
            },
            "anonymous_mode": {
                "description": "强制匿名模式",
                "type": "bool",
                "hint": "开启后将忽略下方 Cookies，仅使用插件自动获取的匿名指纹（buvid3/buvid4）。适合不希望配置登录凭据的场景，画质上限约 720P。关闭时若填写了 Cookies 则优先使用登录态。",
                "default": false
            },
            "allow_quality_fallback": {
                "description": "超限时自动降画质",
                "type": "bool",
                "hint": "当视频大小超过限制时，自动尝试更低画质下载。仅对 bilibili-api 通道生效。",
                "default": true
            },
            "merge_send": {
                "description": "B站合并发送",
                "type": "bool",
                "hint": "开启后将 B 站视频信息和视频合并转发发送（多P默认合并）。不开启只发送单独视频；视频合并转发总是会有点bug，推荐单独发送。",
                "default": false
            },
            "summary_mode": {
                "description": "B站摘要模式",
                "type": "string",
                "hint": "决定合并发送时摘要节点使用纯文字还是渲染卡片。元数据获取失败时自动降级为文字摘要。",
                "default": "文字摘要",
                "options": [
                    "文字摘要",
                    "渲染卡片"
                ]
            },
            "enable_multi_page": {
                "description": "B站多P视频处理",
                "type": "bool",
                "hint": "开启后，遇到多P视频将按配置下载多个分P。",
                "default": true
            },
            "multi_page_max": {
                "description": "B站多P最多下载数量",
                "type": "int",
                "hint": "多P视频最多下载的分P数量。",
                "default": 3,
                "min": 1,
                "max": 20
            },
            "max_duration_seconds": {
                "description": "B站最大视频时长(秒)",
                "type": "int",
                "hint": "视频时长超过该值时直接提示并忽略后续解析。设为 0 表示不限制。",
                "default": 300,
                "min": 0,
                "max": 86400
            },
            "cookies": {
                "description": "B站Cookies",
                "type": "string",
                "hint": "粘贴导出的 Cookie 字符串（可选）。留空时插件会自动向 B站申请匿名指纹（buvid3/buvid4）绕过基础风控；若需 1080P+ 画质仍需填写登录 Cookie。",
                "default": ""
            }
        }
    },
    "douyin_settings": {
        "description": "抖音设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "抖音最多发送媒体数",
                "type": "int",
                "hint": "抖音图集/动图最多发送的数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "抖音视频合并发送",
                "type": "bool",
                "hint": "仅对视频生效。开启时发送摘要+视频的合并转发；关闭时只发送单独视频。图文笔记始终使用合并转发。",
                "default": false
            },
            "summary_mode": {
                "description": "抖音摘要模式",
                "type": "string",
                "hint": "决定合并发送时摘要节点使用纯文字还是渲染卡片。",
                "default": "文字摘要",
                "options": [
                    "文字摘要",
                    "渲染卡片"
                ]
            }
        }
    },
    "weibo_settings": {
        "description": "微博设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "微博最多发送媒体数",
                "type": "int",
                "hint": "微博图文最多发送的图片数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "微博视频合并发送",
                "type": "bool",
                "hint": "仅对视频微博生效。",
                "default": false
            },
            "download_original": {
                "description": "下载微博原图",
                "type": "bool",
                "hint": "开启后优先下载微博原图/大图。",
                "default": true
            },
            "cookies": {
                "description": "微博Cookies",
                "type": "string",
                "hint": "可选。粘贴浏览器导出的 Cookie 字符串。",
                "default": ""
            }
        }
    },
    "twitter_settings": {
        "description": "X 设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "X 最多发送媒体数",
                "type": "int",
                "hint": "单条推文最多发送的图片和视频数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "X 单视频合并发送",
                "type": "bool",
                "hint": "仅对单视频推文生效。",
                "default": false
            }
        }
    },
    "xhs_settings": {
        "description": "小红书设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "小红书最多发送媒体数",
                "type": "int",
                "hint": "小红书图集最多发送的数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "小红书视频合并发送",
                "type": "bool",
                "hint": "仅对视频笔记生效。",
                "default": false
            },
            "summary_mode": {
                "description": "小红书摘要模式",
                "type": "string",
                "hint": "决定摘要节点使用纯文字还是渲染卡片。",
                "default": "文字摘要",
                "options": [
                    "文字摘要",
                    "渲染卡片"
                ]
            },
            "download_original": {
                "description": "下载小红书原图",
                "type": "bool",
                "hint": "开启后通过 CDN 直接下载原始高质量图片。",
                "default": true
            },
            "prefer_ci_png": {
                "description": "小红书优先CI-PNG转码",
                "type": "bool",
                "hint": "开启后优先通过腾讯云CI将图片转码为PNG格式。",
                "default": true
            },
            "auto_unmerge_threshold_mb": {
                "description": "小红书自动解合阈值(MB)",
                "type": "int",
                "hint": "当下载的图片总大小超过此值时，改为逐条发送。设为0禁用。",
                "default": 50
            },
            "qq_image_size_limit_mb": {
                "description": "QQ图片转文件阈值(MB)",
                "type": "int",
                "hint": "当单张图片超过此大小时，改为文件组件发送。设为0禁用转换。",
                "default": 30,
                "min": 0,
                "max": 200
            },
            "concurrent_download": {
                "description": "小红书图片并发下载",
                "type": "bool",
                "hint": "开启后同时下载多张图片。",
                "default": true
            }
        }
    },
    "general_settings": {
        "description": "通用设置",
        "type": "object",
        "items": {
            "retry_count": {
                "description": "解析失败重试次数",
                "type": "int",
                "hint": "各平台解析失败时的重试次数，设为0禁用重试",
                "default": 3,
                "min": 0,
                "max": 10
            },
            "reaction_emoji_enabled": {
                "description": "识别后表情回应",
                "type": "bool",
                "hint": "识别到链接/卡片后点一个表情，提示开始处理。",
                "default": true
            },
            "reaction_emoji_list": {
                "description": "回应表情ID列表(0~5个)",
                "type": "list",
                "hint": "QQ emoji_id，空列表=不回应，最多5个。",
                "default": [
                    127827
                ]
            },
            "reaction_emoji_strategy": {
                "description": "回应策略",
                "type": "string",
                "hint": "随机:每次从列表抽1个。顺序循环:按列表依次全部回应。",
                "default": "随机",
                "options": [
                    "随机",
                    "顺序循环"
                ]
            },
            "auto_install_fonts": {
                "description": "自动安装插件字体",
                "type": "bool",
                "hint": "默认关闭。开启后在插件重载/加载时自动下载中文主字体和 Emoji 字体。",
                "default": false
            },
            "custom_font_path": {
                "description": "自定义主字体路径",
                "type": "string",
                "hint": "可选。填写本机或容器内可访问的字体文件绝对路径。",
                "default": ""
            },
            "custom_emoji_font_path": {
                "description": "自定义 Emoji 字体路径",
                "type": "string",
                "hint": "可选。填写本机或容器内可访问的 Emoji 字体文件绝对路径。",
                "default": ""
            },
            "max_video_size_mb": {
                "description": "最大视频大小 (MB)",
                "type": "int",
                "hint": "超过此大小的视频将不会下载。设置为 0 表示无限制。",
                "default": 200,
                "min": 0,
                "max": 1000
            },
            "merge_send_as_sender": {
                "description": "合并转发显示为发送者",
                "type": "bool",
                "hint": "开启后合并转发的发送人显示为发送链接的用户；关闭则显示为 Bot。",
                "default": false
            },
            "error_notify_mode": {
                "description": "错误通知模式",
                "type": "string",
                "hint": "控制解析/下载失败时 Bot 是否在群内发送错误消息。",
                "default": "静默",
                "options": [
                    "静默",
                    "脱敏",
                    "报错"
                ]
            }
        }
    },
    "group_filter": {
        "description": "群过滤(黑/白名单)",
        "hint": "默认黑名单模式且列表为空=所有群都放行。私聊不受过滤影响。",
        "type": "object",
        "items": {
            "mode": {
                "description": "过滤模式",
                "type": "string",
                "hint": "黑名单:列表内的群禁用解析;白名单:仅列表内的群启用解析。",
                "default": "黑名单",
                "options": [
                    "黑名单",
                    "白名单"
                ]
            },
            "group_list": {
                "description": "群号列表",
                "type": "list",
                "hint": "QQ 群号(纯数字字符串)。例如 123456789。",
                "default": []
            }
        }
    }
}